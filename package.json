{
  "name": "dukkanti-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI and API test suite for the Dukkanti storefront",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test --project=ui --project=api --project=customer",
    "test:smoke": "playwright test --project=smoke --project=smoke-customer",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:customer": "playwright test --project=customer",
    "test:cleanup": "playwright test --project=cleanup",
    "test:exclusive": "playwright test --project=exclusive --workers=1",
    "test:cross-browser": "playwright test --project=smoke-firefox --project=smoke-webkit --project=smoke-mobile-chrome --project=smoke-mobile-safari",
    "test:all": "tsx scripts/run-all.ts",
    "known-bugs": "tsx scripts/known-bugs.ts",
    "report": "playwright show-report",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:tag:smoke": "playwright test --project=ui --project=api --project=customer --grep @smoke",
    "test:tag:regression": "playwright test --project=ui --project=api --project=customer --grep @regression",
    "test:tag:pricing": "playwright test --project=ui --project=api --project=customer --grep @pricing",
    "test:tag:dataquality": "playwright test --project=ui --project=api --project=customer --grep @dataquality",
    "test:tag:states": "playwright test --project=ui --project=api --project=customer --grep @states",
    "test:tag:i18n": "playwright test --project=ui --project=api --project=customer --grep @i18n",
    "test:tag:nonfunctional": "playwright test --project=ui --project=api --project=customer --grep @nonfunctional",
    "test:tag:a11y": "playwright test --project=ui --project=customer --grep @a11y",
    "test:tag:api": "playwright test --project=ui --project=api --project=customer --grep @api",
    "test:home": "playwright test --project=ui --project=api --project=customer tests/home",
    "test:cart": "playwright test --project=ui --project=api --project=customer tests/cart",
    "test:checkout": "playwright test --project=ui --project=api --project=customer tests/checkout",
    "test:orders": "playwright test --project=ui --project=api --project=customer tests/orders",
    "test:product": "playwright test --project=ui --project=api --project=customer tests/product",
    "test:account": "playwright test --project=ui --project=api --project=customer tests/account",
    "test:content": "playwright test --project=ui --project=api --project=customer tests/content",
    "test:sweep": "playwright test --project=ui --project=customer tests/sweep",
    "test:contract": "playwright test --project=customer tests/contract",
    "test:tag:negative": "playwright test --project=ui --project=api --project=customer --grep @negative",
    "test:tag:security": "playwright test --project=ui --project=api --project=customer --grep @security"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.10",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
