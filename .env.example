# Copy to .env and fill in. Never commit .env.

# Storefront and API
BASE_URL=https://dev.dukkanti.com
API_URL=https://api.stg.dukkanti.com/v1

# Cloudflare Access in front of the storefront. Use ONE of these:
# 1) a service token (needed on CI)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# 2) the value of the CF_Authorization cookie from a browser that is already let in (local only, it expires)
CF_AUTHORIZATION=

# Customer login: phone number in international format, and the fixed test OTP
CUSTOMER_PHONE=
CUSTOMER_OTP=
# Only needed when CUSTOMER_PHONE has no country code. The app accepts +971, +977 and +1.
CUSTOMER_DIAL_CODE=+971
# Optional second customer, for "user A cannot see user B's data" tests
CUSTOMER2_PHONE=
CUSTOMER2_OTP=

# Stripe test card used at checkout
STRIPE_TEST_CARD=4242424242424242

# Test data the store owner keeps on dev (these are the defaults)
TEST_COUPON_CODE=SAVE10
OUT_OF_STOCK_PRODUCT_SLUG=smart-chef-sucre-vanilline-7g

# Store settings the tests expect (checked in tests/setup/store.setup.ts)
EXPECT_CURRENCY=AED
